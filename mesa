#!/usr/bin/env python3
"""mesa — manage disposable Podman work environments.

Commands:
  build [name]              Build an image: 'images/<name>/Dockerfile', or the
                              base Dockerfile as localhost/mesa:latest
  new   [name] [-i image]   Create a fresh environment (refuses if it exists)
  shell [name] [-i image]   Attach to the environment (starts or recreates the
                              container if needed)
  stop  [name]              Stop the environment's container (environment and data are kept)
  gui   [name] <cmd...>     Launch a graphical app inside the environment
  rm    [name] [-a] [-f]     Remove the container, keep all data (-a/--all also
                              destroys all data; -f/--force skips confirmation)
  logs  [name]              Show the container logs
  ls                        List all environments, their status and image
  config [key] [value]      Show settings, or set one (keys: default, image)
"""

import os
import re
import shutil
import stat
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
IMAGE_DEFAULT = "localhost/mesa:latest"
HOST_UID = os.getuid()


def _xdg(env_var, default_rel):
    value = os.environ.get(env_var, "")
    if value:
        return Path(value).expanduser()
    return Path.home() / default_rel


CONFIG_DIR = _xdg("XDG_CONFIG_HOME", ".config") / "mesa"
CONFIG_FILE = CONFIG_DIR / "config"
DATA_DIR = _xdg("XDG_DATA_HOME", ".local/share") / "mesa"

USAGE = f"""mesa — manage disposable Podman work environments

Usage: mesa <command> [name] [args...]

Commands:
  build [name]              Build an image: 'images/<name>/Dockerfile', or the
                              base Dockerfile as localhost/mesa:latest
  new   [name] [-i image]   Create a fresh environment (refuses if it exists)
  shell [name] [-i image]   Attach to the environment (starts or recreates the
                              container if needed)
  stop  [name]              Stop the environment's container (environment and data are kept)
  gui   [name] <cmd...>     Launch a graphical app inside the environment
  rm    [name] [-a] [-f]     Remove the container, keep all data (-a/--all also
                              destroys all data; -f/--force skips confirmation)
  logs  [name]              Show the container logs
  ls                        List all environments, their status and image
  config [key] [value]      Show settings, or set one (keys: default, image)

An environment exists as long as its data workspace exists
(~/.local/share/mesa/<name>/workspace). Containers are disposable: 'shell'
starts or recreates them as needed, and only 'rm' removes the environment.

'name' defaults to the configured default name ('mesa config default <name>'),
or "default" if unset. Running 'mesa' with no arguments shows this help.

'image' is an image name (a tag under localhost/mesa) or a full image
reference. New environments use the configured default image
('mesa config image <image>'), or the one given with '-i'. Each environment
remembers its image, so recreated containers use the image they were
created from.
"""


def cfg_get(key):
    try:
        lines = CONFIG_FILE.read_text().splitlines()
    except FileNotFoundError:
        return ""
    for line in reversed(lines):
        if line.startswith(f"{key}="):
            return line.split("=", 1)[1]
    return ""


def cfg_set(key, value):
    lines = CONFIG_FILE.read_text().splitlines() if CONFIG_FILE.is_file() else []
    updated = [f"{key}={value}" if line.startswith(f"{key}=") else line for line in lines]
    if not any(line.startswith(f"{key}=") for line in updated):
        updated.append(f"{key}={value}")
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text("\n".join(updated) + "\n")


def image_ref(value=""):
    """Resolve an image name to a full image reference.

    Accepts a short name (a tag under localhost/mesa), a full image
    reference (anything with ':' or '/'), or empty for the default.
    """
    if not value:
        value = cfg_get("image") or IMAGE_DEFAULT
    if ":" in value or "/" in value:
        return value
    return f"localhost/mesa:{value}"


def env_file(name):
    return DATA_DIR / name / "env"


def env_get(name, key):
    try:
        lines = env_file(name).read_text().splitlines()
    except FileNotFoundError:
        return ""
    for line in reversed(lines):
        if line.startswith(f"{key}="):
            return line.split("=", 1)[1]
    return ""


def env_set(name, key, value):
    path = env_file(name)
    lines = path.read_text().splitlines() if path.is_file() else []
    updated = [f"{key}={value}" if line.startswith(f"{key}=") else line for line in lines]
    if not any(line.startswith(f"{key}=") for line in updated):
        updated.append(f"{key}={value}")
    path.write_text("\n".join(updated) + "\n")


def stored_image(name):
    """The image an environment was created from (the default if unknown)."""
    return env_get(name, "image") or image_ref()


def image_exists(ref):
    return subprocess.run(["podman", "image", "exists", ref]).returncode == 0


def die_missing_image(ref):
    short = ref.removeprefix("localhost/mesa:")
    if short != ref:
        hint = f"mesa build {short}"
    else:
        hint = f"mesa build, or pull the image: podman pull {ref}"
    print(f"Image '{ref}' not found. Create it with: {hint}", file=sys.stderr)
    sys.exit(1)


def parse_image_flag(args, command):
    """Split args into (image, positional) for commands taking -i/--image."""
    image = ""
    positional = []
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-i", "--image"):
            if i + 1 >= len(args):
                print(f"{command}: {arg} needs a value", file=sys.stderr)
                sys.exit(2)
            image = args[i + 1]
            i += 2
        elif arg.startswith("--image="):
            image = arg.split("=", 1)[1]
            i += 1
        elif arg.startswith("-") and arg != "-":
            print(f"Unknown option: '{arg}'. Supported: -i, --image", file=sys.stderr)
            sys.exit(2)
        else:
            positional.append(arg)
            i += 1
    return image, positional


def podman(*args, check=True):
    """Run podman, passing output through to the terminal."""
    return subprocess.run(["podman", *args], check=check).returncode


def podman_output(*args):
    """Run podman and return its stdout."""
    result = subprocess.run(["podman", *args], check=True, capture_output=True, text=True)
    return result.stdout


def podman_exec(*args):
    """Replace this process with podman (interactive commands)."""
    os.execvp("podman", ["podman", *args])


def container(name):
    return f"mesa-{name}"


def exists(name):
    return workspace_dir(name).is_dir()


def container_exists(name):
    return container(name) in podman_output("ps", "-a", "--format", "{{.Names}}").splitlines()


def running(name):
    return container(name) in podman_output("ps", "--format", "{{.Names}}").splitlines()


def workspace_dir(name):
    return DATA_DIR / name / "workspace"


def resolve_name(args):
    return args[0] if args else (cfg_get("default") or "default")


def die_not_running(name):
    print(f"Not running. Try: mesa new {name}", file=sys.stderr)
    sys.exit(1)


def confirm(question):
    try:
        answer = input(f"{question} [y/N] ")
    except EOFError:
        return False
    return answer.strip().lower() in ("y", "yes")


def gui_env_args():
    return [
        "env",
        f"XDG_RUNTIME_DIR=/run/user/{HOST_UID}",
        f"WAYLAND_DISPLAY={os.environ.get('WAYLAND_DISPLAY', '')}",
        f"DISPLAY={os.environ.get('DISPLAY', '')}",
    ]


def is_socket(path):
    try:
        return stat.S_ISSOCK(os.stat(path).st_mode)
    except OSError:
        return False


def wayland_socket_args():
    """Bind-mount only the Wayland compositor socket, at its host path.
    The rest of the runtime directory — including the SSH agent, session
    bus, keyring, pipewire/pulseaudio, and the systemd user instance —
    stays private to the host."""
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR", "")
    wayland_display = os.environ.get("WAYLAND_DISPLAY", "")
    if wayland_display and os.path.isabs(wayland_display):
        wayland_sock = wayland_display
    elif wayland_display and runtime_dir:
        wayland_sock = os.path.join(runtime_dir, wayland_display)
    else:
        return []
    if is_socket(wayland_sock):
        return ["-v", f"{wayland_sock}:{wayland_sock}"]
    return []


def cmd_build(args):
    if args:
        name = args[0]
        if not re.fullmatch(r"[A-Za-z0-9._-]+", name):
            print(f"Invalid image name: '{name}'", file=sys.stderr)
            return 2
        context = ROOT / "images" / name
        if not (context / "Dockerfile").is_file():
            print(f"No Dockerfile at {context}/Dockerfile", file=sys.stderr)
            return 1
        tag = f"localhost/mesa:{name}"
    else:
        context = ROOT
        tag = IMAGE_DEFAULT
    podman("build", "-t", tag, "--build-arg", f"HOST_UID={HOST_UID}", str(context))


def create_container(name, image):
    if not image_exists(image):
        die_missing_image(image)
    ws = workspace_dir(name)
    podman(
        "run", "-d", "--name", container(name), "--replace",
        "--userns=keep-id",
        "--cap-add=NET_RAW", "--cap-add=NET_ADMIN",
        "--network=host",
        "-e", f"XDG_RUNTIME_DIR=/run/user/{HOST_UID}",
        "-e", f"WAYLAND_DISPLAY={os.environ.get('WAYLAND_DISPLAY', '')}",
        "-e", f"DISPLAY={os.environ.get('DISPLAY', '')}",
        *wayland_socket_args(),
        "-v", "/tmp/.X11-unix:/tmp/.X11-unix:Z",
        "-v", "/dev/dri:/dev/dri",
        "-v", f"{ws}:/workspace:Z",
        image,
    )


def create_environment(name, image):
    if not image_exists(image):
        die_missing_image(image)
    ws = workspace_dir(name)
    ws.mkdir(parents=True, exist_ok=True)
    env_set(name, "image", image)
    create_container(name, image)


def cmd_new(args):
    image, positional = parse_image_flag(args, "new")
    name = resolve_name(positional)
    if exists(name):
        print(f"Environment '{name}' already exists. Attach with: mesa shell {name}", file=sys.stderr)
        return 1
    image = image_ref(image)
    create_environment(name, image)
    print(f"Environment '{name}' started (image: {image}). Attach with: mesa shell {name}")
    return 0


def cmd_shell(args):
    image_flag, positional = parse_image_flag(args, "shell")
    name = resolve_name(positional)
    if not exists(name):
        if not confirm(f"Environment '{name}' does not exist. Create it?"):
            die_not_running(name)
        create_environment(name, image_ref(image_flag))
    elif not container_exists(name):
        image = image_ref(image_flag) if image_flag else stored_image(name)
        env_set(name, "image", image)
        create_container(name, image)
    elif not running(name):
        podman("start", container(name))
        if image_flag:
            print(f"Note: '{name}' keeps its current image ({stored_image(name)}).")
            print(f"To switch, remove the container first: mesa rm {name} && mesa shell {name} -i <image>")
    elif image_flag:
        print(f"Note: '{name}' keeps its current image ({stored_image(name)}).")
        print(f"To switch, remove the container first: mesa rm {name} && mesa shell {name} -i <image>")
    podman_exec("exec", "-it", container(name), "fish", "-l")


def cmd_stop(args):
    name = resolve_name(args)
    if running(name):
        podman("stop", container(name))
        print(f"Environment '{name}' stopped. Container kept; data intact.")
    else:
        print("(not running)")


def cmd_gui(args):
    name = resolve_name(args)
    if not running(name):
        die_not_running(name)
    podman_exec("exec", "-it", container(name), *gui_env_args(), *args[1:])


def cmd_rm(args):
    flags = [a for a in args if a.startswith("-")]
    for f in flags:
        if f not in ("-a", "--all", "-f", "--force"):
            print(f"Unknown option: '{f}'. Supported: -a, --all, -f, --force", file=sys.stderr)
            return 2
    name = resolve_name([a for a in args if not a.startswith("-")])
    data_dir = DATA_DIR / name
    all_data = "-a" in flags or "--all" in flags
    force = "-f" in flags or "--force" in flags
    if not all_data:
        if not container_exists(name):
            print("(already gone)")
            return 0
        if not force and not confirm(f"Remove the container for '{name}'? Data kept at {data_dir}."):
            print("Aborted.")
            return 1
        podman("rm", "-f", container(name), check=False)
        print(f"Container removed; data kept at {data_dir}.")
        print("State inside the container (system packages, home-directory changes) is lost; 'shell' recreates a fresh one from the environment's image.")
        return 0
    if not exists(name) and not container_exists(name):
        print("(already gone)")
        return 0
    if not force and not confirm(f"Destroy environment '{name}' (container and all data under {data_dir})?"):
        print("Aborted.")
        return 1
    if container_exists(name):
        podman("rm", "-f", container(name), check=False)
    if data_dir.is_dir():
        shutil.rmtree(data_dir)
    print(f"Environment '{name}' destroyed.")
    return 0


def cmd_logs(args):
    name = resolve_name(args)
    podman("logs", container(name))


def cmd_ls(args):
    all_containers = set(podman_output("ps", "-a", "--format", "{{.Names}}").splitlines())
    live_containers = set(podman_output("ps", "--format", "{{.Names}}").splitlines())
    names = set()
    if DATA_DIR.is_dir():
        names.update(child.name for child in DATA_DIR.iterdir() if child.is_dir())
    names.update(cname[len("mesa-"):] for cname in all_containers if cname.startswith("mesa-"))
    for name in sorted(names):
        cname = container(name)
        if cname in live_containers:
            status = "running"
        elif cname in all_containers:
            status = "stopped"
        elif exists(name):
            status = "data only"
        else:
            status = "empty"
        image = env_get(name, "image") or "-"
        print(f"{name}\t{status}\t{image}")


def cmd_config(args):
    key = args[0] if args else ""
    value = args[1] if len(args) > 1 else ""
    if key == "":
        if CONFIG_FILE.is_file():
            sys.stdout.write(CONFIG_FILE.read_text())
        else:
            print(f"No settings yet ({CONFIG_FILE})")
        return 0
    if key not in ("default", "image"):
        print(f"Unknown setting: '{key}'. Supported: default, image", file=sys.stderr)
        return 2
    if not value:
        if key == "default":
            print(f"default = {cfg_get('default') or 'default'}")
        else:
            print(f"image = {cfg_get('image') or IMAGE_DEFAULT}")
        return 0
    pattern = r"[A-Za-z0-9._-]+" if key == "default" else r"[A-Za-z0-9._:/-]+"
    if not re.fullmatch(pattern, value):
        print(f"Invalid {key}: '{value}'", file=sys.stderr)
        return 2
    cfg_set(key, value)
    if key == "default":
        print(f"Default environment name set to '{value}'.")
    else:
        print(f"Default image set to '{image_ref(value)}'.")
    return 0


def cmd_help(args):
    print(USAGE)


COMMANDS = {
    "build": cmd_build,
    "new": cmd_new,
    "shell": cmd_shell,
    "stop": cmd_stop,
    "gui": cmd_gui,
    "rm": cmd_rm,
    "logs": cmd_logs,
    "ls": cmd_ls,
    "config": cmd_config,
    "help": cmd_help,
    "-h": cmd_help,
    "--help": cmd_help,
}


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "help"
    handler = COMMANDS.get(cmd)
    if handler is None:
        print(USAGE, file=sys.stderr)
        return 2
    return handler(argv[2:])


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except subprocess.CalledProcessError as err:
        sys.exit(err.returncode)
    except FileNotFoundError:
        print("podman: command not found", file=sys.stderr)
        sys.exit(127)
    except KeyboardInterrupt:
        sys.exit(130)
