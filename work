#!/usr/bin/env bash
# work — manage disposable Podman work environments
#   work build  [name]   build the image (after Containerfile changes)
#   work new    [name]   start a fresh environment (GUI-capable)
#   work shell  [name]   attach to the running environment
#   work gui    [name] <cmd...>   launch a graphical app inside it
#   work rm     [name]   destroy the container (keeps workspace data)
#   work purge  [name]   destroy container AND wipe workspace data
#   work logs   [name]   show container logs
#   work ls              list environments
#   work config [key] [value]  show or set settings (key: default)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE="localhost/secure-workenv:latest"
HOST_UID="$(id -u)"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/work"
CONFIG="$CONFIG_DIR/config"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/work"

# Read a setting from the config file (empty if unset).
cfg_get() {
  [ -r "$CONFIG" ] || return 0
  sed -n "s/^$1=//p" "$CONFIG" | tail -n1
}

cmd="${1:-help}"
name="${2:-$(cfg_get default)}"; name="${name:-default}"
ctn="swe-${name}"
ws="${DATA_DIR}/${name}/workspace"
ws_home="${DATA_DIR}/${name}/home"

build()  { podman build -t "$IMAGE" --build-arg HOST_UID="$HOST_UID" "$ROOT"; }
exists() { podman ps -a --format '{{.Names}}' | grep -qx "$ctn"; }
running(){ podman ps     --format '{{.Names}}' | grep -qx "$ctn"; }

usage() {
  cat <<EOF
work — manage disposable Podman work environments

Usage: work <command> [name] [args...]

Commands:
  build [name]              Build the image (required once, and after Dockerfile changes)
  new   [name]              Start a fresh, GUI-capable environment
  shell [name]              Attach to the running environment (fish login shell)
  gui   [name] <cmd...>     Launch a graphical app inside the environment
  rm    [name]              Destroy the container, keep workspace data
  purge [name]              Destroy the container AND wipe workspace data
  logs  [name]              Show the container logs
  ls                        List all environments
  config [key] [value]      Show settings, or set one (key: default)

'name' defaults to the configured default name ('work config default <name>'),
or "default" if unset. Running 'work' with no arguments shows this help.
EOF
}

case "$cmd" in
  build) build ;;
  new)
    legacy="${ROOT}/workspaces/${name}"
    if [ -d "$legacy" ] && [ ! -e "$ws" ]; then
      mkdir -p "$DATA_DIR"
      mv "$legacy" "$DATA_DIR/${name}"
      echo "Migrated '${name}' from ${ROOT}/workspaces to ${DATA_DIR}"
    fi
    mkdir -p "$ws"
    mkdir -p "$ws_home"
    podman run -d --name "$ctn" --replace \
      --userns=keep-id \
      --cap-add=NET_RAW --cap-add=NET_ADMIN \
      --network=host \
      -e XDG_RUNTIME_DIR=/run/user/$(id -u) \
      -e WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
      -e DISPLAY="${DISPLAY:-}" \
      -v "${XDG_RUNTIME_DIR:?}:/run/user/$(id -u)" \
      -v /tmp/.X11-unix:/tmp/.X11-unix:Z \
      -v /dev/dri:/dev/dri \
      -v "${ws}:/workspace:Z" \
      -v "${ws_home}:/home/researcher:Z" \
      "$IMAGE"
    echo "Environment '${name}' started. Attach with: work shell ${name}" ;;
  shell)
    running || { echo "Not running. Try: work new ${name}"; exit 1; }
    podman exec -it "$ctn" fish -l ;;
  gui)
    # usage: work gui [name] <command...>  e.g. work gui default code --no-sandbox
    running || { echo "Not running. Try: work new ${name}"; exit 1; }
    podman exec -it "$ctn" \
      env XDG_RUNTIME_DIR=/run/user/$(id -u) \
          WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
          DISPLAY="${DISPLAY:-}" \
      "${@:3}" ;;
  rm)
    exists && podman rm -f "$ctn" || echo "(already gone)"
    echo "Container gone. Workspace data kept at ${ws}" ;;
  purge)
    exists && podman rm -f "$ctn" || true
    rm -rf "${ws:?}"; echo "Container and workspace data for '${name}' purged." ;;
  logs) podman logs "$ctn" ;;
  ls)   podman ps -a --filter "name=^swe-" --format '{{.Names}}\t{{.Status}}' | sed 's/^swe-//';;
  config)
    key="${2:-}"; value="${3:-}"
    case "$key" in
      default)
        if [ -n "$value" ]; then
          case "$value" in
            *[!A-Za-z0-9._-]*) echo "Invalid name: '$value'" >&2; exit 2 ;;
          esac
          mkdir -p "$CONFIG_DIR"; touch "$CONFIG"
          if grep -q '^default=' "$CONFIG"; then
            sed -i "s/^default=.*/default=$value/" "$CONFIG"
          else
            printf 'default=%s\n' "$value" >> "$CONFIG"
          fi
          echo "Default environment name set to '$value'."
        else
          cur="$(cfg_get default)"
          echo "default = ${cur:-default}"
        fi ;;
      "")
        if [ -r "$CONFIG" ]; then cat "$CONFIG"; else echo "No settings yet ($CONFIG)"; fi ;;
      *) echo "Unknown setting: '$key'. Supported: default" >&2; exit 2 ;;
    esac ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
